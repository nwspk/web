%u{:style => 'font: 14px/18px monospace'} It's time to talk to:
%table#templateColumns{:border => '0', :cellpadding => '0', :cellspacing => '0', :width => '800'}
  %tr
    %td.templateColumnContainer{:align => 'left', :valign => 'top', :width => '60%'}
      %table{:border => '0', :cellpadding => '10', :cellspacing => '0', :width => '100%'}
        %tr
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} Name:
          %td{:style => 'padding-right: 18px; font: 24px/28px monospace'}= @member.name
        %tr
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} 
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} #{@member.role}, joined #{distance_of_time_in_words_to_now(@member.created_at)} ago
        %tr
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} E-mail:
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'}= @member.email
        %tr
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} Info:
          %td{:style => 'padding-right: 18px; font: 14px/18px monospace'}= @member.showcase_text
        -if @member.url.present?
          %tr
            %td{:style => 'padding-right: 18px; font: 14px/18px monospace'} URL:
            %td{:style => 'padding-right: 18px; font: 14px/18px monospace'}= @member.url
%p{:style => 'color: #555'}
  You are receiving these e-mails because you're setup to receive periodic member reminders every #{pluralize(@reminder.frequency, 'hour')}. Contact ed@newspeak.house to change this.
%p
  %strong Newspeak House