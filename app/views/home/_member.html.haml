- links ||= false
- member_url = safe_external_url(user.url)

.member
  - if member_url
    = link_to member_url do
      = image_tag profile_image_url(user)
  - else
    = image_tag profile_image_url(user)
  .member-text
    - if member_url
      = link_to user.name, member_url
    - else
      = user.name
    = safe_markdown(user.showcase_text)
